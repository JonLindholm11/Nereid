# Nereid Environment Configuration
# Copy this file to .env and fill in your values

# ── Database ────────────────────────────────────────────────────────────────
# Production database connection string
NEREID_DB_URL=postgresql://user:password@localhost:5432/mydb

# Staging schema name (created automatically within the same DB)
NEREID_STAGING_SCHEMA=nereid_staging

# ── Sync Mode ───────────────────────────────────────────────────────────────
# "single" = one XLSX file, tabs map to table names
# "multi"  = folder of CSVs, filenames map to table names
NEREID_MODE=single

# ── File Paths ───────────────────────────────────────────────────────────────
# Path to the XLSX file (single mode)
NEREID_FILE_PATH=/path/to/your/synced/folder/data.xlsx

# Path to the CSV folder (multi mode)
# NEREID_FOLDER_PATH=/path/to/your/synced/folder/

# ── Primary Key ──────────────────────────────────────────────────────────────
# Column name to use as the primary key for diffing
# This column must exist in every table/sheet being synced
NEREID_PK_COLUMN=id

# ── Watch Settings ───────────────────────────────────────────────────────────
# Seconds to wait after a file change before triggering sync (debounce)
NEREID_DEBOUNCE_SECONDS=2