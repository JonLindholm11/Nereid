# Nereid Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Database ─────────────────────────────────────────────────────────────────
# Your PostgreSQL connection string
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE
NEREID_DB_URL=postgresql://user:password@localhost:5432/mydb

# Staging schema name — created automatically inside the same database
# All changes land here first before you approve them to production
NEREID_STAGING_SCHEMA=nereid_staging

# ── Sync Mode ─────────────────────────────────────────────────────────────────
# single = one XLSX file, each tab = one table
# multi  = one folder of CSVs, each filename = one table
NEREID_MODE=single

# ── File Paths ────────────────────────────────────────────────────────────────
# Path to the XLSX file (single mode)
# Point this at your cloud-synced folder (Google Drive, Dropbox, OneDrive)
NEREID_FILE_PATH=/path/to/your/synced/folder/data.xlsx

# Path to the CSV folder (multi mode) — uncomment if using multi mode
# NEREID_FOLDER_PATH=/path/to/your/synced/folder/

# ── Primary Key ───────────────────────────────────────────────────────────────
# The column Nereid uses to identify rows when diffing changes.
# This column must exist in every table being synced.
# Default is "id" — change this if your tables use a different PK column name.
NEREID_PK_COLUMN=id

# ── Watch Settings ────────────────────────────────────────────────────────────
# How long to wait after a file change before triggering a sync (in seconds).
# Increase this if you are using a cloud sync client that writes slowly.
# Recommended: 2 for local files, 5-10 for cloud-synced folders.
NEREID_DEBOUNCE_SECONDS=2